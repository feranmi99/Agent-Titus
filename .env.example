# ============================================================================
# Agent Titus (Swarm Node 01) — Environment Configuration
# Copy this file to `.env` and populate your credentials:
#   cp .env.example .env
# ============================================================================

# --- Telegram Dispatch (Required for live alerts) ---
# Create a bot via @BotFather and obtain your chat/channel ID via @userinfobot
TELEGRAM_BOT_TOKEN=9281041918:AAFfpRdssCvc41Ma8IHcd1P_x6tp0i18K1E
TELEGRAM_CHAT_ID=7297900017

# --- X / Twitter Monitoring ---
# Option 1 (Free, Recommended): Browser session cookies from a secondary X account
X_AUTH_TOKEN=
X_CT0=
# Option 2 (Paid): Official X API v2 Bearer Token (Basic+ tier)
X_BEARER_TOKEN=
# Option 3 (Fallback): Self-hosted / public Nitter-compatible base URL for RSS search
X_NITTER_BASE_URL=

# --- Source Toggles ---
ENABLE_X=true
ENABLE_REDDIT=true
ENABLE_NEWS=true

# --- Polling & Filtering ---
POLL_INTERVAL_SECONDS=300
HTTP_TIMEOUT_SECONDS=20
MAX_ITEM_AGE_HOURS=24
MIN_RELEVANCE_SCORE=3
MAX_ALERTS_PER_CYCLE=15
SEED_ON_FIRST_RUN=true
SEEN_STORE_MAX_ITEMS=20000
LOG_LEVEL=INFO
USER_AGENT=python:agent-titus:v0.1 (personal monitoring bot)
